---
// Página de fuentes (referencias) en cada idioma (/es/fuentes/, /ca/fuentes/, /en/fuentes/), paso 3b de docs/plan-astro.md.
// Diseño del boceto design-ejemplos/fuentes-boceto.html. La tabla la pinta public/js/fuentes.js con los datos de public/data/.
// Admite ?tipo=actividad&actividad=<clave> (el enlace filtrado del pie de las actividades) y ?interno=1 (vista de trabajo).
import Subpagina from '../../layouts/Subpagina.astro';
import { idiomas, usarTextos } from '../../i18n';

export function getStaticPaths() {
  return idiomas.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = usarTextos(lang);
const f = (clave: string) => t(`fuentesPagina.${clave}`);
---
<Subpagina title={f('tituloPagina')} lang={lang} secciones={['fuentesPagina']}>
  <link slot="head" rel="stylesheet" href="/css/fuentes.css" />

  <Fragment slot="cabecera">
    <h1 id="tituloPag">{f('titulo')}</h1>
    <p class="intro" id="intro">{f('intro')}</p>
    <p class="aviso-interno" id="avisoInterno">{f('avisoInterno')}</p>
  </Fragment>

  <!-- --etq-fuentes: título «Fuentes» que se ve encima de las fuentes de cada fila en el móvil -->
  <main class="envoltorio" style={`--etq-fuentes: ${JSON.stringify(f('thFuentes'))}`}>
    <section class="filtros" aria-label={f('filtrosAria')}>
      <div class="fila">
        <div class="campo"><label for="fTipo" id="lTipo">{f('fTipo')}</label>
          <select id="fTipo"></select></div>
        <div class="campo"><label for="fMes" id="lMes">{f('fMes')}</label>
          <select id="fMes"></select></div>
        <div class="campo"><label for="fRegion" id="lRegion">{f('fRegion')}</label>
          <select id="fRegion"></select></div>
        <div class="campo" style="flex-basis: 260px"><label for="fBuscar" id="lBuscar">{f('fBuscar')}</label>
          <input type="search" id="fBuscar" placeholder={f('fBuscarPh')}></div>
      </div>
      <div class="acciones-filtros"><button type="button" class="btn-limpiar" id="btnLimpiar">{f('quitarFiltros')}</button></div>
    </section>
    <p class="cuenta" id="cuenta" role="status"></p>
    <div class="tabla-caja">
      <table>
        <caption class="sr" id="capTabla">{f('cap')}</caption>
        <thead><tr>
          <th scope="col" id="thDonde">{f('thDonde')}</th><th scope="col" id="thDato">{f('thDato')}</th><th scope="col" id="thFuentes">{f('thFuentes')}</th>
          <th scope="col" class="solo-interno" id="thEstado">{f('thEstado')}</th><th scope="col" class="solo-interno" id="thNota">{f('thNota')}</th>
        </tr></thead>
        <tbody id="cuerpo"></tbody>
      </table>
    </div>
  </main>

  <script slot="scripts" is:inline src="/js/fuentes.js"></script>
</Subpagina>
