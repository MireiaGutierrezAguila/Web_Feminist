---
// Hecha por una mujer informática (fondo de lluvia de código en js/portada.js).
import { usarTextos } from '../../i18n';
interface Props {
  lang?: string;
}
const { lang = 'es' } = Astro.props;
const t = usarTextos(lang);
---
<section class="bloque" id="informatica">
  <div class="codigo" id="lluvia">
    <div class="contenido informatica">
      <h2>{t('informatica.titulo')}</h2>
      <p>{t('informatica.parrafo1')}</p>
      <p>{t('informatica.parrafo2')}</p>
    </div>
  </div>
</section>
