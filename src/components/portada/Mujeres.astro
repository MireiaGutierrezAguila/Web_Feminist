---
// Mujeres de la historia: el carrusel de cartas lo rellena js/portada.js con public/data/mujeres.json.
import { usarTextos } from '../../i18n';
interface Props {
  lang?: string;
}
const { lang = 'es' } = Astro.props;
const t = usarTextos(lang);
---
<section class="bloque" id="mujeres">
  <h2>{t('mujeres.titulo')}</h2>
  <p class="pista">{t('mujeres.pista')}</p>
  <ul class="carrusel" id="carrusel" tabindex="0" aria-label={t('mujeres.carruselAria')}></ul>
</section>
