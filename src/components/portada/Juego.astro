---
// El juego Feminist: texto, botones, QR y vídeo.
import { usarTextos } from '../../i18n';
interface Props {
  lang?: string;
}
const { lang = 'es' } = Astro.props;
const t = usarTextos(lang);
const nueva = t('comun.pestanaNueva');
---
<section class="bloque" id="juego">
  <div class="juego-grid">
    <div class="juego-texto">
      <h2>{t('juego.titulo')}</h2>
      <!-- set:html porque el texto lleva <strong> (viene de nuestro propio archivo de idioma) -->
      <p set:html={t('juego.parrafo1')} />
      <p>{t('juego.parrafo2')}</p>
      <p>{t('juego.parrafo3')}</p>
      <div class="botones">
        <a class="btn" href="https://mireiagutierrezaguila.github.io/Portfolio_Mireia/juegos/feminist.html" target="_blank" rel="noopener" aria-label={`${t('juego.verJuego')} ${nueva}`}>{t('juego.verJuego')}</a>
        <a class="btn alt btn-play" href="https://play.google.com/store/apps/details?id=com.mireiaguila9.feminist&amp;utm_source=emea_Med" target="_blank" rel="noopener" aria-label={`Google Play ${nueva}`}><img src="/img/opt/android-robot.webp" alt="" width="125" height="218"><span>Google Play</span></a>
      </div>
      <!-- Código QR (de Mireia, hecho con Canva): lleva a la ficha del juego en Google Play. Solo se ve con ratón y pantalla ancha: en el móvil ya está el botón -->
      <div class="qr-juego">
        <a href="https://play.google.com/store/apps/details?id=com.mireiaguila9.feminist&amp;utm_source=emea_Med" target="_blank" rel="noopener" aria-label={`${t('juego.qrAria')} ${nueva}`}><img src="/img/opt/qr-google-play.webp" alt={t('juego.qrAlt')} width="480" height="477" loading="lazy"></a>
        <p>{t('juego.qrTexto')}</p>
      </div>
    </div>
    <div class="video-juego">
      <video id="videoJuego" muted loop playsinline preload="none" poster="/media/video-juego-poster.webp" disablepictureinpicture aria-label={t('juego.videoAria')}>
        <source src="/media/video-juego.mp4" type="video/mp4">
      </video>
      <button class="btn-video" id="btnVideo" type="button" aria-pressed="false">{t('juego.reproducirVideo')}</button>
    </div>
  </div>
</section>
