---
// Actividades: tarjetas cuadradas con la imagen de Mireia; los datos están en src/data/portada.json.
import datos from '../../data/portada.json';
import { usarTextos, enIdioma } from '../../i18n';
interface Props {
  lang?: string;
}
const { lang = 'es' } = Astro.props;
const t = usarTextos(lang);
const nueva = t('comun.pestanaNueva');
---
<section class="bloque" id="actividades">
  <h2>{t('actividades.titulo')}</h2>
  <p class="intro">{t('actividades.intro')}</p>
  <ul class="act-tarjetas">
    {datos.actividades.map((a) => (
      <li><a class="act-tarjeta" style={`--tinta: ${a.tinta}`} href={`/${lang}/actividades/${a.ruta}/`} target="_blank" rel="noopener" aria-label={`${enIdioma(a.titulo, lang)} ${nueva}`}><img src={`/img/opt/actividades/${a.imagen}.webp`} alt="" width="800" height="800" loading="lazy"><span>{enIdioma(a.titulo, lang)}</span></a></li>
    ))}
  </ul>
</section>
