---
// Hoja del calendario: la rellena js/portada.js con la efeméride del día o un lema (public/data/calendario.json y pancarta-frases.json).
import { usarTextos } from '../../i18n';
interface Props {
  lang?: string;
}
const { lang = 'es' } = Astro.props;
const t = usarTextos(lang);
---
<aside class="calendario" aria-label={t('calendario.aria')}>
  <img class="cal-base" src="/img/opt/calendario-todo.webp" alt="" width="680" height="651">
  <div class="cal-frente">
    <img class="cal-hoja-img" src="/img/opt/calendario-hoja.webp" alt="" width="680" height="651">
    <div class="cal-hoja">
      <div class="cal-cabecera"><span id="calMes">{t('calendario.mes')}</span><span id="calAnio"></span></div>
      <time class="cal-dia" id="calFecha"><span class="cal-semana" id="calSemana">{t('calendario.dia')}</span><span class="cal-num" id="calNum">0</span></time>
      <ul class="cal-frases" id="calFrases"></ul>
    </div>
  </div>
</aside>
