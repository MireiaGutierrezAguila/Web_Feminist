---
// Cabecera de la portada: logo, botón de efectos y selector de idioma.
// El selector son enlaces a la portada en cada idioma; se abren en la misma pestaña (excepción a la regla
// de «pestaña nueva», decidida por Mireia el 28-11-2026: cambiar de idioma no es abrir otra página).
import { usarTextos, idiomas, nombreIdioma } from '../../i18n';
interface Props {
  lang?: string;
}
const { lang = 'es' } = Astro.props;
const t = usarTextos(lang);
---
<div class="wrap">
  <header class="top">
    <div class="top-row">
      <a class="logo" href="#">
        <svg class="venus" viewBox="0 0 22 30" aria-hidden="true"><circle cx="11" cy="9" r="7" fill="none" stroke="#F5F5F0" stroke-width="3"/><path d="M11 16v13M5 23h12" stroke="#F5F5F0" stroke-width="3" stroke-linecap="round"/></svg>
        Feminist
      </a>
      <div class="controles">
        <button type="button" class="fx-btn" id="fxBtn">{t('cabecera.quitarEfectos')}</button>
        <nav class="idiomas" aria-label={t('cabecera.idioma')}>
          {idiomas.map((l) => (
            <a href={`/${l}/`} hreflang={l} lang={l} aria-label={nombreIdioma[l]} aria-current={l === lang ? 'page' : undefined}>{l.toUpperCase()}</a>
          ))}
        </nav>
      </div>
    </div>
  </header>
</div>
