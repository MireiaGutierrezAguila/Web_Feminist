---
// Cabecera de la portada: logo, botón de efectos y selector de idioma (el selector funcionará en el paso 1c).
---
<div class="wrap">
  <header class="top">
    <div class="top-row">
      <a class="logo" href="#">
        <svg class="venus" viewBox="0 0 22 30" aria-hidden="true"><circle cx="11" cy="9" r="7" fill="none" stroke="#F5F5F0" stroke-width="3"/><path d="M11 16v13M5 23h12" stroke="#F5F5F0" stroke-width="3" stroke-linecap="round"/></svg>
        Feminist
      </a>
      <div class="controles">
        <button type="button" class="fx-btn" id="fxBtn">Quitar efectos</button>
        <div class="idiomas" role="group" aria-label="Idioma">
          <button type="button" aria-pressed="true">ES</button>
          <button type="button" aria-pressed="false">CA</button>
          <button type="button" aria-pressed="false">EN</button>
        </div>
      </div>
    </div>
  </header>
</div>
