---
// Glosario: 6 palabras de ejemplo con las letras de Mireia. Todas existen en el glosario del
// Ayuntamiento de Barcelona (public/data/glosario.json); los datos están en src/data/portada.json.
import datos from '../../data/portada.json';
import { usarTextos, enIdioma } from '../../i18n';
interface Props {
  lang?: string;
}
const { lang = 'es' } = Astro.props;
const t = usarTextos(lang);
const nueva = t('comun.pestanaNueva');
---
<section class="bloque" id="glosario">
  <h2>{t('glosario.titulo')}</h2>
  <p class="intro">{t('glosario.intro')}</p>
  <ul class="glo-tarjetas">
    {datos.glosario.map((p) => (
      <li><a class="glo-tarjeta" style={`--halo: ${p.halo}; --tinta: ${p.tinta}`} href={`/${lang}/glosario/#${p.ancla}`} target="_blank" rel="noopener" aria-label={`${enIdioma(p.palabra, lang)} ${nueva}`}><span class="glo-img"><img src={`/img/opt/glosario/letra-${p.letra}.webp`} alt="" loading="lazy" decoding="async"></span><span>{enIdioma(p.palabra, lang)}</span></a></li>
    ))}
  </ul>
  <div class="botones" style="margin-top:22px"><a class="btn" href={`/${lang}/glosario/`} target="_blank" rel="noopener" aria-label={`${t('glosario.verMas')} ${nueva}`}>{t('glosario.verMas')}</a></div>
</section>
